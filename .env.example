# ---------------------------------------------------------------------------
# SUPABASE DATABASE
# Two URLs are required. Get both from:
#   Supabase Dashboard -> your project -> Connect (top bar) -> ORMs / Prisma
#
# DATABASE_URL = "Transaction pooler" connection (port 6543) + ?pgbouncer=true
#   Used by the app at runtime. Pooled = safe for serverless (Vercel).
#
# DIRECT_URL   = "Direct connection" (port 5432)
#   Used ONLY for `prisma migrate` / `prisma db push`. Bypasses the pooler.
#
# Replace [PROJECT-REF], [PASSWORD], and [REGION] with your project's values.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# AUTH (Auth.js / NextAuth v5)
# Generate a secret with:  npx auth secret     (or)   openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=""
# Must be the exact origin the site is served from (Auth.js builds its
# redirects from it). On Vercel you can leave it unset — the platform URL is
# trusted automatically — or set it to your production domain.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SITE
# Your public URL in production, e.g. https://alqaim.store — used for canonical
# links, the sitemap, JSON-LD and social previews. No trailing slash.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SEED — the first SUPER_ADMIN created by `npm run db:seed`.
# Set a real address and a long, unique password BEFORE seeding a live store,
# then sign in and keep these out of version control.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@alqaim.test"
SEED_ADMIN_PASSWORD="replace-with-a-long-unique-password"

# ---------------------------------------------------------------------------
# IMAGE STORAGE — Supabase Storage
# In the Supabase dashboard: Storage -> New bucket -> name it "product-images"
# and mark it PUBLIC (or adapt lib/storage/supabase.ts to use signed URLs).
# NEXT_PUBLIC_SUPABASE_URL is your project URL (Project Settings -> API).
# SUPABASE_SERVICE_ROLE_KEY is the service_role secret (same page) — server-only,
# never exposed to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# ---------------------------------------------------------------------------
# PAYMENTS / EMAIL  (later phases — abstractions default to COD / dev fallback)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=""
# RESEND_API_KEY=""
